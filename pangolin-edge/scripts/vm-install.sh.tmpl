#!/usr/bin/env bash
# Post-copy setup on the Pangolin VM (run by Terraform remote-exec or manually).
set -euo pipefail

INSTALL_DIR="${install_dir}"
SSH_USER="${ssh_user}"
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$${PATH:-}"

apt_busy() {
  pgrep -x apt >/dev/null 2>&1 && return 0
  pgrep -x apt-get >/dev/null 2>&1 && return 0
  pgrep -x dpkg >/dev/null 2>&1 && return 0
  if command -v fuser >/dev/null 2>&1; then
    sudo fuser /var/lib/apt/lists/lock /var/lib/dpkg/lock /var/lib/dpkg/lock-frontend >/dev/null 2>&1 && return 0
  fi
  return 1
}

wait_for_apt() {
  sudo systemctl stop apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service 2>/dev/null || true
  local n=0
  while apt_busy; do
    n=$((n + 1))
    if (( n > 24 )); then
      echo "apt still locked after 2 minutes" >&2
      exit 1
    fi
    echo "Waiting for apt ($${n}/24)..."
    sleep 5
  done
}

cd "$${INSTALL_DIR}"
sudo mkdir -p config/traefik/logs config/db config/letsencrypt config/crowdsec/db
sudo touch config/letsencrypt/acme.json config/traefik/logs/access.log
sudo chmod 600 config/letsencrypt/acme.json

if ! sudo docker --version >/dev/null 2>&1; then
  tries=0
  while true; do
    wait_for_apt
    if curl -fsSL https://get.docker.com | sudo sh; then
      break
    fi
    tries=$((tries + 1))
    if (( tries >= 4 )); then
      echo "docker install failed after 4 attempts" >&2
      exit 1
    fi
    echo "docker install hit apt lock, retry $${tries}/4"
    sleep 10
  done
fi
if ! sudo docker compose version >/dev/null 2>&1; then
  wait_for_apt
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y docker-compose-plugin
fi

sudo docker compose pull
sudo docker compose up -d
# Pangolin reads config.yml only at startup (Integration API on 3003 needs a restart after config changes).
# Traefik reads plugin versions from static config only at startup.
sudo docker compose restart pangolin traefik

%{ if enable_crowdsec ~}
chmod +x configure-crowdsec-bouncer.sh
./configure-crowdsec-bouncer.sh "$${INSTALL_DIR}"
wait_for_apt
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y logrotate
sudo tee /etc/logrotate.d/pangolin-traefik > /dev/null <<'EOF'
${logrotate_config}
EOF
%{ endif ~}

if ! command -v ufw >/dev/null 2>&1; then
  wait_for_apt
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y ufw
fi
${ufw_ssh_allow}
sudo ufw allow 80/tcp
sudo ufw allow 443/tcp
sudo ufw allow 51820/udp
sudo ufw allow 21820/udp
sudo ufw --force enable

for ((i = 1; i <= 60; i++)); do
  TOKEN="$(sudo docker logs pangolin 2>&1 | sed -n 's/^Token: //p' | tail -1)"
  if [[ -n "$${TOKEN}" ]]; then
    printf '%s' "$${TOKEN}" | sudo tee "$${INSTALL_DIR}/.setup-token" >/dev/null
    sudo chmod 600 "$${INSTALL_DIR}/.setup-token"
    sudo chown "$${SSH_USER}:$${SSH_USER}" "$${INSTALL_DIR}/.setup-token"
    exit 0
  fi
  sleep 5
done

echo 'pangolin setup token not found in container logs' >&2
exit 1
