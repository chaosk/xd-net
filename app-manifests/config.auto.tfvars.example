## Copy to config.auto.tfvars (gitignored) if you need overrides.

# kubeconfig_path = "../infra/_out/kubeconfig"

# Pin releases to match your cluster / chart choices:
# gateway_api_release   = "v1.5.1"   # match Envoy Gateway v1.8.x compatibility matrix
# install_gateway_api_crds = false   # true on fresh clusters; false if GW API CRDs already exist
# install_gateway_api_experimental_crds = false  # TCPRoute v1alpha2; required for pangolin-operator
# cert_manager_release  = "v1.21.1"   # match apps/ cert_manager_chart_version
# prometheus_operator_release = "v0.92.1"   # ServiceMonitor CRDs for monitoring/ GitOps apps
# argocd_release        = "v3.5.1"   # match apps/argocd_chart_version (argo-helm 10.3.3)
# envoy_gateway_release = "v1.8.2"   # match apps/envoy_gateway_version
